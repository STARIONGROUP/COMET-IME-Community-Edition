<dx:DXWindow x:Class="CDP4Composition.Views.AnnotationDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:lc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:navigation="clr-namespace:CDP4Composition.Navigation"
             Width="560"
             Height="460"
             MinWidth="420"
             MinHeight="320"
             dx:ThemeManager.ThemeName="Seven"
             navigation:ExtendedDialogResultCloser.DialogResult="{Binding DialogResult}"
             mc:Ignorable="d"
             Title="{Binding DialogTitle}">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="8,6"
                Background="#FFEFF3F8"
                BorderBrush="#FFBFCBD9"
                BorderThickness="1">
            <StackPanel>
                <TextBlock FontWeight="Bold" Text="{Binding KindName, Mode=OneWay}" />
                <TextBlock Margin="0,2,0,0"
                           Foreground="#FF45515F"
                           Text="{Binding AnnotatedThingCaption, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding AnnotatedThingCaption, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <lc:LayoutControl Grid.Row="1" Margin="0,8,0,0" Orientation="Vertical" ScrollBars="None">
            <lc:LayoutGroup Orientation="Vertical" VerticalAlignment="Stretch">
                <lc:LayoutItem Label="Short Name"
                               Visibility="{Binding HasIdentification, Converter={dx:BooleanToVisibilityConverter}}">
                    <dxe:TextEdit EditValue="{Binding ShortName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                </lc:LayoutItem>
                <lc:LayoutItem Label="Title"
                               Visibility="{Binding HasIdentification, Converter={dx:BooleanToVisibilityConverter}}">
                    <dxe:TextEdit EditValue="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                </lc:LayoutItem>
                <lc:LayoutItem Label="Classification"
                               Visibility="{Binding HasIdentification, Converter={dx:BooleanToVisibilityConverter}}">
                    <dxe:ComboBoxEdit IsTextEditable="False"
                                      ItemsSource="{Binding PossibleClassifications}"
                                      EditValue="{Binding Classification, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </lc:LayoutItem>
                <lc:LayoutItem Label="Content" VerticalAlignment="Stretch">
                    <dxe:TextEdit MinHeight="140"
                                  AcceptsReturn="True"
                                  TextWrapping="Wrap"
                                  VerticalContentAlignment="Top"
                                  VerticalScrollBarVisibility="Auto"
                                  EditValue="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                </lc:LayoutItem>
            </lc:LayoutGroup>
        </lc:LayoutControl>

        <StackPanel Grid.Row="2"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="85"
                    Margin="0,0,8,0"
                    Command="{Binding OkCommand}"
                    Content="OK"
                    IsDefault="True" />
            <Button MinWidth="85"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</dx:DXWindow>
