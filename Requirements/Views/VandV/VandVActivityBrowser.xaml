<UserControl x:Class="CDP4Requirements.Views.VandVActivityBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cdp4Composition="clr-namespace:CDP4Composition;assembly=CDP4Composition"
             xmlns:services="clr-namespace:CDP4Composition.Services;assembly=CDP4Composition"
             xmlns:views="clr-namespace:CDP4Composition.Views;assembly=CDP4Composition"
             xmlns:rows="clr-namespace:CDP4Requirements.ViewModels.Rows"
             xmlns:selectors="clr-namespace:CDP4Requirements.Selectors"
             d:DesignHeight="300"
             d:DesignWidth="700"
             dx:ThemeManager.ThemeName="{Binding Path=ThemeName}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CDP4Composition;component/CommonView/Resources/CDP4Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <selectors:VandVTreeListNodeImageSelector x:Key="VandVActivityTreeListNodeSelector" />

            <!--  A report expands to the activities recorded in it.  -->
            <HierarchicalDataTemplate DataType="{x:Type rows:VandVSpecificationRowViewModel}" ItemsSource="{Binding ContainedRows}">
                <ContentPresenter Content="{Binding}" ContentTemplate="{Binding View.DefaultDataRowTemplate}" />
            </HierarchicalDataTemplate>

            <!--  An activity expands to its procedure steps.  -->
            <HierarchicalDataTemplate DataType="{x:Type rows:VandVActivityRowViewModel}" ItemsSource="{Binding ContainedRows}">
                <ContentPresenter Content="{Binding}" ContentTemplate="{Binding View.DefaultDataRowTemplate}" />
            </HierarchicalDataTemplate>

            <!--  Procedure steps are the leaves: this panel shows the work, not the requirements it covers.  -->
            <HierarchicalDataTemplate DataType="{x:Type rows:VandVStepRowViewModel}">
                <ContentPresenter Content="{Binding}" ContentTemplate="{Binding View.DefaultDataRowTemplate}" />
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  the stock browser toolbar and header, exactly as the Requirements browser uses them: the Create split
              button fills itself from the context menu's Create entries, so nothing is duplicated here  -->
        <views:CommonThingControl GridView="{Binding ElementName=View}" FilteringMode="ParentBranch" IsExportVisible="True" />

        <views:BrowserHeader Grid.Row="1" />

        <dxg:TreeListControl Grid.Row="2"
                             ItemsSource="{Binding ReportRows}"
                             FilterString="{Binding FilterString, Mode=TwoWay}"
                             IsFilterEnabled="{Binding IsFilterEnabled, Mode=TwoWay}"
                             SelectedItem="{Binding SelectedThing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             services:GridUpdateService.UpdateStarted="{Binding HasUpdateStarted, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">

            <dxmvvm:Interaction.Behaviors>
                <cdp4Composition:ContextMenuBehavior />

                <!--  KeyToCommand, not KeyBinding: a KeyBinding on the tree resolves against the wrong DataContext  -->
                <dxmvvm:KeyToCommand KeyGesture="Ctrl+E" Command="{Binding UpdateCommand}" />
                <dxmvvm:KeyToCommand KeyGesture="Ctrl+I" Command="{Binding InspectCommand}" />
            </dxmvvm:Interaction.Behaviors>

            <dxg:TreeListControl.View>
                <dxg:TreeListView Name="View"
                                  AllowEditing="False"
                                  AutoWidth="False"
                                  ExpandStateFieldName="IsExpanded"
                                  HorizontalScrollbarVisibility="Auto"
                                  NavigationStyle="Cell"
                                  ShowHorizontalLines="False"
                                  ShowIndicator="False"
                                  ShowNodeImages="True"
                                  NodeImageSelector="{StaticResource VandVActivityTreeListNodeSelector}"
                                  NodeImageSize="20,16"
                                  ShowVerticalLines="False"
                                  TreeDerivationMode="HierarchicalDataTemplate"
                                  TreeLineStyle="Solid"
                                  VerticalScrollbarVisibility="Auto"
                                  ShowFilterPanelMode="Default">

                    <dxg:TreeListView.ContextMenu>
                        <ContextMenu Name="RowContextMenu" />
                    </dxg:TreeListView.ContextMenu>

                </dxg:TreeListView>
            </dxg:TreeListControl.View>

            <dxg:TreeListControl.Columns>
                <dxg:TreeListColumn FieldName="ShortName" Header="Report / Activity / Step" Width="230" Fixed="Left" />
                <dxg:TreeListColumn FieldName="Name" Header="Name" Width="230" />
                <dxg:TreeListColumn FieldName="Coverage" Header="V&amp;V Items" Width="160" />
                <dxg:TreeListColumn FieldName="StepAction" Header="Action" Width="220" />
                <dxg:TreeListColumn FieldName="StepExpected" Header="Expected" Width="200" />
                <dxg:TreeListColumn FieldName="StepActual" Header="Actual" Width="200" />
                <dxg:TreeListColumn FieldName="StepResult" Header="Step Result" Width="100" />
                <dxg:TreeListColumn FieldName="Method" Header="Method" Width="110" />
                <dxg:TreeListColumn FieldName="Stage" Header="Stage" Width="80" />
                <dxg:TreeListColumn FieldName="Status" Header="Status" Width="100" />
                <dxg:TreeListColumn FieldName="PlannedDate" Header="Planned" Width="90" />
                <dxg:TreeListColumn FieldName="ActualDate" Header="Actual" Width="90" />
                <dxg:TreeListColumn FieldName="EvidenceReference" Header="Evidence" Width="140" />
                <dxg:TreeListColumn FieldName="Owner" Header="Owner" Width="80" />
            </dxg:TreeListControl.Columns>
        </dxg:TreeListControl>
    </Grid>
</UserControl>
