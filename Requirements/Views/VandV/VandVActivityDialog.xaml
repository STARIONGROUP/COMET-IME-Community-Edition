<dx:DXWindow x:Class="CDP4Requirements.Views.VandVActivityDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:lc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:navigation="clr-namespace:CDP4Composition.Navigation;assembly=CDP4Composition"
             Width="760"
             Height="620"
             dx:ThemeManager.ThemeName="Seven"
             navigation:ExtendedDialogResultCloser.DialogResult="{Binding DialogResult}"
             mc:Ignorable="d"
             Title="{Binding Title}">

    <dx:DXWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CDP4Composition;component/CommonView/Resources/CDP4Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </dx:DXWindow.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <lc:LayoutControl Grid.Row="0"
                          Orientation="Vertical"
                          VerticalAlignment="Stretch"
                          ScrollBars="None">

            <lc:LayoutGroup Margin="-10,-7,-10,-5"
                            Orientation="Vertical"
                            View="Tabs"
                            SelectedTabIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                            VerticalAlignment="Stretch"
                            lc:LayoutControl.AllowHorizontalSizing="True">

                <!--  BASIC, identification and planning: written once here, inherited by every item performed by this activity  -->
                <lc:LayoutGroup Header="Basic" Orientation="Vertical" VerticalAlignment="Top">
                    <TextBlock Margin="4,2,4,8"
                               FontStyle="Italic"
                               Foreground="#FF5A6B7D"
                               TextWrapping="Wrap"
                               Text="A shared activity is one task, e.g. producing the mass budget, that performs the verification of many V&amp;V items. What is written here is inherited by every item performed by this activity, unless the item overrides it." />
                    <lc:LayoutItem Label="Activity No.: " ToolTip="The activity number. It is the activity's short name, so it is unique in the model by construction.">
                        <dxe:TextEdit EditValue="{Binding ShortName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Name: ">
                        <dxe:TextEdit EditValue="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Owner: ">
                        <dxe:ComboBoxEdit DisplayMember="Name"
                                          IsTextEditable="False"
                                          ItemsSource="{Binding PossibleOwners}"
                                          EditValue="{Binding Owner, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Report: " ToolTip="The output document (deliverable) this activity's results are recorded in, e.g. a FAT report or the mass budget. Only reports that exist are offered: create one first with 'Create Report' in the Activities browser. The report is the activity's container, so picking another one moves the activity, and clearing it moves the activity back to the V&amp;V specification. This is not the Plan Reference: the plan is the input document saying what will be verified how.">
                        <dxe:ComboBoxEdit DisplayMember="ShortName"
                                          IsTextEditable="False"
                                          NullValueButtonPlacement="EditBox"
                                          ItemsSource="{Binding PossibleReports}"
                                          SelectedItem="{Binding Report, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <TextBlock Margin="4,0,4,6"
                               FontStyle="Italic"
                               Foreground="#FF9A6B00"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasNoReports, Converter={dx:BooleanToVisibilityConverter}}"
                               Text="No report exists yet. Create one first with 'Create Report' in the Activities browser, or leave this empty to keep the activity in the V&amp;V specification." />
                    <lc:LayoutItem Label="Method: " ToolTip="Every V&amp;V item this activity performs inherits this method, so it is mandatory here.">
                        <dxe:ComboBoxEdit IsTextEditable="False"
                                          ItemsSource="{Binding PossibleMethods}"
                                          EditValue="{Binding Method, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Stage Gate: " ToolTip="An activity is executed once, at one gate, and every item it performs inherits that gate. Recurring work (a mass budget at PDR and again at CDR) is one activity per gate, each with its own execution record and evidence.">
                        <dxe:ComboBoxEdit IsTextEditable="False"
                                          ItemsSource="{Binding PossibleStages}"
                                          EditValue="{Binding Stage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Level: ">
                        <dxe:ComboBoxEdit IsTextEditable="False"
                                          ItemsSource="{Binding PossibleLevels}"
                                          EditValue="{Binding Level, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Description: ">
                        <dxe:TextEdit Height="70"
                                      AcceptsReturn="True"
                                      TextWrapping="Wrap"
                                      VerticalContentAlignment="Top"
                                      EditValue="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Facility: ">
                        <dxe:TextEdit EditValue="{Binding Facility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="External Party: ">
                        <dxe:TextEdit EditValue="{Binding ResponsibleExternal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Planned Date: ">
                        <dxe:DateEdit EditValue="{Binding PlannedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Plan Reference: ">
                        <dxe:TextEdit EditValue="{Binding PlanReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                </lc:LayoutGroup>

                <!--  PROCEDURE, written once on the activity instead of per requirement  -->
                <lc:LayoutGroup Header="Procedure" Orientation="Vertical" VerticalAlignment="Stretch">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Margin="0,0,0,8"
                                   FontStyle="Italic"
                                   Foreground="#FF5A6B7D"
                                   TextWrapping="Wrap"
                                   Text="The procedure of the activity, written once. Action and Expected are written while planning. Actual and Result are filled in while running, which is the as-run record the report needs. Steps renumber automatically." />

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,6,4" VerticalAlignment="Center" Text="Procedure Ref.:" />
                            <dxe:TextEdit Grid.Row="0" Grid.Column="1" Margin="0,0,12,4"
                                          ToolTip="The identifier of the procedure document this activity follows, when the procedure is written down elsewhere."
                                          EditValue="{Binding ProcedureReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Text="Preconditions:" />
                            <dxe:TextEdit Grid.Row="1" Grid.Column="1" Margin="0,0,12,0"
                                          EditValue="{Binding Preconditions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,6,0" VerticalAlignment="Center" Text="Conditions:" />
                            <dxe:TextEdit Grid.Row="1" Grid.Column="3"
                                          EditValue="{Binding Conditions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <dxg:GridControl AutoGenerateColumns="None"
                                             ItemsSource="{Binding ProcedureSteps}"
                                             SelectedItem="{Binding SelectedStep, Mode=TwoWay}">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="Number" Header="#" Width="30" FixedWidth="True" AllowEditing="False" AllowResizing="False" />
                                    <dxg:GridColumn FieldName="Action" Header="Action" Width="200">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:MemoEditSettings AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" ShowIcon="False" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="ExpectedResult" Header="Expected" Width="180">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:MemoEditSettings AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" ShowIcon="False" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="ActualResult" Header="Actual" Width="180">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:MemoEditSettings AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" ShowIcon="False" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="Result" Header="Result" Width="95" FixedWidth="True">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings IsTextEditable="False" ItemsSource="{Binding DataContext.PossibleStepResults, RelativeSource={RelativeSource AncestorType=dxg:GridControl}}" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView AutoWidth="True"
                                                   NavigationStyle="Cell"
                                                   RowMinHeight="24"
                                                   ShowGroupPanel="False"
                                                   ShowIndicator="False"
                                                   UseLightweightTemplates="None" />
                                </dxg:GridControl.View>
                            </dxg:GridControl>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <Button Margin="0,0,0,4" MinWidth="66" Padding="6,3" Command="{Binding AddStepCommand}" Content="Add" />
                                <Button Margin="0,0,0,4" MinWidth="66" Padding="6,3" Command="{Binding RemoveStepCommand}" Content="Remove" />
                                <Button Margin="0,0,0,4" MinWidth="66" Padding="6,3" Command="{Binding MoveStepUpCommand}" Content="Up" />
                                <Button MinWidth="66" Padding="6,3" Command="{Binding MoveStepDownCommand}" Content="Down" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </lc:LayoutGroup>

                <!--  EXECUTION, recorded once on the activity and inherited by every item it performs  -->
                <lc:LayoutGroup Header="Execution" Orientation="Vertical" VerticalAlignment="Top">
                    <lc:LayoutItem Label="Status: ">
                        <dxe:ComboBoxEdit IsTextEditable="False"
                                          ItemsSource="{Binding PossibleStatuses}"
                                          EditValue="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Actual Date: ">
                        <dxe:DateEdit EditValue="{Binding ActualDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Result: ">
                        <dxe:TextEdit Height="110"
                                      AcceptsReturn="True"
                                      TextWrapping="Wrap"
                                      VerticalContentAlignment="Top"
                                      EditValue="{Binding Result, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Evidence Ref.: " ToolTip="The report or record backing the result, typically the report this activity is filed under.">
                        <dxe:ComboBoxEdit AutoComplete="True"
                                          IsTextEditable="True"
                                          ItemsSource="{Binding PossibleReportReferences}"
                                          EditValue="{Binding EvidenceReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>

                    <TextBlock Margin="4,8,4,0"
                               FontStyle="Italic"
                               Foreground="#FF5A6B7D"
                               TextWrapping="Wrap"
                               Text="The execution record is written once, here. Every V&amp;V item performed by this activity inherits it in the register and the export, and can be explicitly closed out in bulk once the activity has run." />
                </lc:LayoutGroup>

                <!--  V&V ITEMS, read-only: which requirements this one activity actually covers  -->
                <lc:LayoutGroup Header="V&amp;V Items" Orientation="Vertical" VerticalAlignment="Stretch">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Margin="0,0,0,8"
                                   FontStyle="Italic"
                                   Foreground="#FF5A6B7D"
                                   TextWrapping="Wrap"
                                   Text="{Binding LinkedItemsCaption, Mode=OneWay}" />

                        <dxg:GridControl Grid.Row="1"
                                         AutoGenerateColumns="None"
                                         ItemsSource="{Binding LinkedItems}">
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="ShortName" Header="V&amp;V Item" Width="120" />
                                <dxg:GridColumn FieldName="Requirement" Header="Verifies" Width="240" />
                                <dxg:GridColumn FieldName="Status" Header="Status" Width="90" />
                                <dxg:GridColumn FieldName="Compliance" Header="Compliance" Width="110" />
                                <dxg:GridColumn FieldName="CloseOut" Header="Close-out" Width="80" />
                            </dxg:GridControl.Columns>
                            <dxg:GridControl.View>
                                <dxg:TableView AllowEditing="False"
                                               AutoWidth="False"
                                               NavigationStyle="Row"
                                               ShowGroupPanel="False"
                                               ShowIndicator="False"
                                               UseLightweightTemplates="None" />
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </Grid>
                </lc:LayoutGroup>

            </lc:LayoutGroup>
        </lc:LayoutControl>

        <StackPanel Grid.Row="1"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="90"
                    Height="26"
                    Margin="4,0"
                    Command="{Binding OkCommand}"
                    Content="{Binding OkButtonCaption}"
                    IsDefault="True" />
            <Button Width="90"
                    Height="26"
                    Margin="4,0"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</dx:DXWindow>
