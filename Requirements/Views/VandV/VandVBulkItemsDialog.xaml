<dx:DXWindow x:Class="CDP4Requirements.Views.VandVBulkItemsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:lc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:navigation="clr-namespace:CDP4Composition.Navigation;assembly=CDP4Composition"
             Width="640"
             Height="560"
             dx:ThemeManager.ThemeName="Seven"
             navigation:ExtendedDialogResultCloser.DialogResult="{Binding DialogResult}"
             mc:Ignorable="d"
             Title="{Binding Title}">

    <dx:DXWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CDP4Composition;component/CommonView/Resources/CDP4Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </dx:DXWindow.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap">
            <Run Text="One thin V&amp;V item is created per ticked requirement, all performed by " /><Run FontWeight="Bold" Text="{Binding ActivityCaption, Mode=OneWay}" /><Run Text=". The items inherit the activity's method, stage gate and execution record. Acceptance criteria stay per requirement: the box below is the default, and any requirement judged against something else states its own next to it. Where a requirement carries a parametric constraint, pick it and press Use to copy it in. Every ticked requirement needs criteria before the items can be created." />
        </TextBlock>

        <lc:LayoutControl Grid.Row="1" Orientation="Vertical" ScrollBars="None">
            <lc:LayoutItem Label="Link Type: " ToolTip="'verifies' checks against the requirement baseline; 'validates' checks against the mission or stakeholder need.">
                <dxe:ComboBoxEdit IsTextEditable="False"
                                  ItemsSource="{Binding PossibleLinkTypes}"
                                  EditValue="{Binding LinkType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </lc:LayoutItem>
            <lc:LayoutItem Label="Owner: ">
                <dxe:ComboBoxEdit DisplayMember="Name"
                                  IsTextEditable="False"
                                  ItemsSource="{Binding PossibleOwners}"
                                  EditValue="{Binding Owner, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </lc:LayoutItem>
            <lc:LayoutItem Label="Default Acceptance Criteria: " ToolTip="Applied to every ticked requirement that states no criteria of its own.">
                <dxe:TextEdit Height="50"
                              AcceptsReturn="True"
                              TextWrapping="Wrap"
                              VerticalContentAlignment="Top"
                              EditValue="{Binding AcceptanceCriteria, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </lc:LayoutItem>
        </lc:LayoutControl>

        <StackPanel Grid.Row="2"
                    Margin="0,4,0,4"
                    Orientation="Horizontal">
            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Requirements:" />
            <Button Margin="0,0,4,0" Padding="8,2" Command="{Binding SelectAllCommand}" Content="Select All" />
            <Button Margin="0,0,4,0" Padding="8,2" Command="{Binding ClearSelectionCommand}" Content="Clear" />
            <Button Padding="8,2"
                    Command="{Binding ApplyDefaultCommand}"
                    Content="Fill Blanks With Default"
                    ToolTip="Copies the default onto every ticked requirement that has no criteria yet, so each can then be edited from a filled-in starting point." />
        </StackPanel>

        <ListBox Grid.Row="3"
                 BorderThickness="1"
                 HorizontalContentAlignment="Stretch"
                 ItemsSource="{Binding PossibleRequirements}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  VerticalAlignment="Top"
                                  Margin="0,3,0,0"
                                  Content="{Binding Display}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <dxe:TextEdit IsEnabled="{Binding IsSelected}"
                                          NullText="uses the default above"
                                          ShowNullTextForEmptyValue="True"
                                          TextWrapping="Wrap"
                                          ToolTip="Acceptance criteria for this requirement only. Leave empty to use the default above."
                                          EditValue="{Binding AcceptanceCriteria, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Margin="0,2,0,0"
                                  IsEnabled="{Binding IsSelected}"
                                  Visibility="{Binding HasParametricConstraints, Converter={dx:BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center"
                                           Text="from constraint:" />

                                <dxe:ComboBoxEdit Grid.Column="1"
                                                  IsTextEditable="False"
                                                  DisplayMember="Display"
                                                  ItemsSource="{Binding PossibleParametricConstraints}"
                                                  SelectedItem="{Binding SelectedParametricConstraint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Grid.Column="2"
                                        Margin="4,0,0,0"
                                        Padding="8,0"
                                        Command="{Binding UseParametricConstraintCommand}"
                                        Content="Use" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="Firebrick"
                       Text="{Binding Validation}"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Width="90"
                        Height="26"
                        Margin="4,0"
                        Command="{Binding OkCommand}"
                        Content="Create"
                        IsDefault="True" />
                <Button Width="90"
                        Height="26"
                        Margin="4,0"
                        Command="{Binding CancelCommand}"
                        Content="Cancel"
                        IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</dx:DXWindow>
