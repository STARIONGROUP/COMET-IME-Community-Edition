<dx:DXWindow x:Class="CDP4Requirements.Views.VandVItemDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:lc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:navigation="clr-namespace:CDP4Composition.Navigation;assembly=CDP4Composition"
             Width="820"
             Height="660"
             dx:ThemeManager.ThemeName="Seven"
             navigation:ExtendedDialogResultCloser.DialogResult="{Binding DialogResult}"
             mc:Ignorable="d"
             Title="{Binding Title}">

    <dx:DXWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CDP4Composition;component/CommonView/Resources/CDP4Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </dx:DXWindow.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <lc:LayoutControl Grid.Row="0"
                          Orientation="Vertical"
                          VerticalAlignment="Stretch"
                          ScrollBars="None">

            <lc:LayoutGroup Margin="-10,-7,-10,-5"
                            Orientation="Vertical"
                            View="Tabs"
                            SelectedTabIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                            VerticalAlignment="Stretch"
                            lc:LayoutControl.AllowHorizontalSizing="True">

                <!--  BASIC, identification and how this item relates to the requirement  -->
                <lc:LayoutGroup Header="Basic"
                                Orientation="Vertical"
                                VerticalAlignment="Top">
                    <lc:LayoutItem Label="Requirement: ">
                        <Label Content="{Binding RequirementCaption, Mode=OneWay}" FontWeight="Bold" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Link Type: " ToolTip="'verifies' checks the item against the requirement baseline; 'validates' checks it against the mission or stakeholder need.">
                        <dxe:ComboBoxEdit IsTextEditable="False"
                                          ItemsSource="{Binding PossibleLinkTypes}"
                                          EditValue="{Binding LinkType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Short Name: ">
                        <dxe:TextEdit EditValue="{Binding ShortName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Name: ">
                        <dxe:TextEdit EditValue="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Owner: ">
                        <dxe:ComboBoxEdit DisplayMember="Name"
                                          IsTextEditable="False"
                                          ItemsSource="{Binding PossibleOwners}"
                                          EditValue="{Binding Owner, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Performed By: "
                                   ToolTip="The shared activity that performs this item, e.g. producing the mass budget. Pick it first: the method, stage gate, procedure and execution record then come from the activity, and every field this item leaves empty inherits from it.">
                        <dxe:ComboBoxEdit DisplayMember="Display"
                                          IsTextEditable="False"
                                          NullValueButtonPlacement="EditBox"
                                          ItemsSource="{Binding PossibleActivities}"
                                          SelectedItem="{Binding SelectedActivityChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Method: " ToolTip="Only needed when no shared activity performs this item, or to override the activity's method for this requirement.">
                        <dxe:ComboBoxEdit IsTextEditable="False"
                                          NullValueButtonPlacement="EditBox"
                                          ItemsSource="{Binding PossibleMethods}"
                                          EditValue="{Binding Method, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </lc:LayoutItem>
                    <TextBlock Margin="4,0,4,4"
                               FontStyle="Italic"
                               Foreground="#FF5A6B7D"
                               TextWrapping="Wrap"
                               Text="{Binding MethodInheritanceNote, Mode=OneWay}"
                               Visibility="{Binding IsPerformedByActivity, Converter={dx:BooleanToVisibilityConverter}}" />
                    <lc:LayoutItem Label="Stage Gate: " ToolTip="Only needed when no shared activity performs this item, or to override the activity's stage gate for this requirement.">
                        <dxe:ComboBoxEdit IsTextEditable="False"
                                          NullValueButtonPlacement="EditBox"
                                          ItemsSource="{Binding PossibleStages}"
                                          EditValue="{Binding Stage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </lc:LayoutItem>
                    <TextBlock Margin="4,0,4,4"
                               FontStyle="Italic"
                               Foreground="#FF5A6B7D"
                               TextWrapping="Wrap"
                               Text="{Binding StageInheritanceNote, Mode=OneWay}"
                               Visibility="{Binding IsPerformedByActivity, Converter={dx:BooleanToVisibilityConverter}}" />
                    <lc:LayoutItem Label="Acceptance Criteria: "
                                   ToolTip="What must be observed for this activity to pass. 'From constraint' copies one of the requirement's parametric constraints in, so the human-readable and machine-evaluable criteria agree.">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="90" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <dxe:TextEdit AcceptsReturn="True"
                                          TextWrapping="Wrap"
                                          VerticalContentAlignment="Top"
                                          EditValue="{Binding Acceptance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                            <Grid Grid.Row="1"
                                  Margin="0,4,0,0"
                                  Visibility="{Binding HasParametricConstraints, Converter={dx:BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,0,4,0"
                                           VerticalAlignment="Center"
                                           Text="from constraint:" />
                                <dxe:ComboBoxEdit Grid.Column="1"
                                                  IsTextEditable="False"
                                                  ItemsSource="{Binding PossibleParametricConstraints}"
                                                  DisplayMember="Display"
                                                  SelectedItem="{Binding SelectedParametricConstraint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2"
                                        Margin="4,0,0,0"
                                        Padding="8,0"
                                        Command="{Binding UseParametricConstraintCommand}"
                                        Content="Use" />
                            </Grid>
                        </Grid>
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Description: ">
                        <dxe:TextEdit Height="70"
                                      AcceptsReturn="True"
                                      TextWrapping="Wrap"
                                      VerticalContentAlignment="Top"
                                      EditValue="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>

                </lc:LayoutGroup>

                <!--  PLANNING  -->
                <lc:LayoutGroup Header="Planning" Orientation="Vertical" VerticalAlignment="Top">
                    <lc:LayoutItem Label="Method: ">
                        <dxe:ComboBoxEdit IsTextEditable="False"
                                          NullValueButtonPlacement="EditBox"
                                          ItemsSource="{Binding PossibleMethods}"
                                          EditValue="{Binding Method, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </lc:LayoutItem>
                    <TextBlock Margin="4,0,4,4"
                               FontStyle="Italic"
                               Foreground="#FF5A6B7D"
                               TextWrapping="Wrap"
                               Text="{Binding MethodInheritanceNote, Mode=OneWay}"
                               Visibility="{Binding IsPerformedByActivity, Converter={dx:BooleanToVisibilityConverter}}" />
                    <lc:LayoutItem Label="Stage Gate: ">
                        <dxe:ComboBoxEdit IsTextEditable="False"
                                          NullValueButtonPlacement="EditBox"
                                          ItemsSource="{Binding PossibleStages}"
                                          EditValue="{Binding Stage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </lc:LayoutItem>
                    <TextBlock Margin="4,0,4,4"
                               FontStyle="Italic"
                               Foreground="#FF5A6B7D"
                               TextWrapping="Wrap"
                               Text="{Binding StageInheritanceNote, Mode=OneWay}"
                               Visibility="{Binding IsPerformedByActivity, Converter={dx:BooleanToVisibilityConverter}}" />
                    <lc:LayoutItem Label="Acceptance Criteria: "
                                   ToolTip="What must be observed for this activity to pass. 'From constraint' copies one of the requirement's parametric constraints in, so the human-readable and machine-evaluable criteria agree.">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="100" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <dxe:TextEdit AcceptsReturn="True"
                                          TextWrapping="Wrap"
                                          VerticalContentAlignment="Top"
                                          EditValue="{Binding Acceptance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                            <Grid Grid.Row="1"
                                  Margin="0,4,0,0"
                                  Visibility="{Binding HasParametricConstraints, Converter={dx:BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,0,4,0"
                                           VerticalAlignment="Center"
                                           Text="from constraint:" />
                                <dxe:ComboBoxEdit Grid.Column="1"
                                                  IsTextEditable="False"
                                                  ItemsSource="{Binding PossibleParametricConstraints}"
                                                  DisplayMember="Display"
                                                  SelectedItem="{Binding SelectedParametricConstraint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2"
                                        Margin="4,0,0,0"
                                        Padding="8,0"
                                        Command="{Binding UseParametricConstraintCommand}"
                                        Content="Use" />
                            </Grid>
                        </Grid>
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Level: ">
                        <dxe:ComboBoxEdit IsTextEditable="False"
                                          ItemsSource="{Binding PossibleLevels}"
                                          EditValue="{Binding Level, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Criticality: ">
                        <dxe:ComboBoxEdit IsTextEditable="False"
                                          ItemsSource="{Binding PossibleCriticalities}"
                                          EditValue="{Binding Criticality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Plan Reference: " ToolTip="The section of the verification plan (the input document that says what will be verified how) that describes this item. Not the report: the report is the output document the activity's results are recorded in, and is picked on the activity. Values already used in the model are offered.">
                        <dxe:ComboBoxEdit AutoComplete="True"
                                          IsTextEditable="True"
                                          ItemsSource="{Binding SuggestedPlanReferences}"
                                          EditValue="{Binding PlanReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Planned Date: ">
                        <dxe:DateEdit EditValue="{Binding PlannedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="External Party: ">
                        <dxe:TextEdit EditValue="{Binding ResponsibleExternal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Coverage Note: ">
                        <dxe:TextEdit EditValue="{Binding CoverageNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                </lc:LayoutGroup>

                <!--  PROCEDURE, the ordered steps ECSS-E-ST-10-03 expects of a test procedure and its as-run record  -->
                <lc:LayoutGroup Header="Procedure" Orientation="Vertical" VerticalAlignment="Stretch">

                    <!--  a plain Grid, not stacked LayoutItems: the layout control distributes leftover height over
                          its items, which pushed the fields into the middle of the tab and starved the table  -->
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Margin="0,0,0,4"
                                   FontWeight="Bold"
                                   Foreground="#FF9A6B00"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding IsPerformedByActivity, Converter={dx:BooleanToVisibilityConverter}}"
                                   Text="A shared activity performs this item: its procedure is written once, on the activity. Leave this tab empty unless this requirement needs its own, additional steps." />

                        <TextBlock Grid.Row="1"
                                   Margin="0,0,0,8"
                                   FontStyle="Italic"
                                   Foreground="#FF5A6B7D"
                                   TextWrapping="Wrap"
                                   Text="Action and Expected are written while planning. Actual and Result are filled in while running the procedure, which is the as-run record the test report needs. Steps renumber automatically. Double-click a cell to edit; the text cells accept several lines." />

                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,6,4" VerticalAlignment="Center" Text="Procedure Ref.:" />
                            <dxe:TextEdit Grid.Row="0" Grid.Column="1" Margin="0,0,12,4"
                                          ToolTip="The identifier of the procedure document this activity follows, when the procedure is written down elsewhere."
                                          EditValue="{Binding ProcedureReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,6,4" VerticalAlignment="Center" Text="Facility:" />
                            <dxe:TextEdit Grid.Row="0" Grid.Column="3" Margin="0,0,0,4"
                                          EditValue="{Binding Facility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center" Text="Preconditions:" />
                            <dxe:TextEdit Grid.Row="1" Grid.Column="1" Margin="0,0,12,0"
                                          EditValue="{Binding Preconditions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,6,0" VerticalAlignment="Center" Text="Conditions:" />
                            <dxe:TextEdit Grid.Row="1" Grid.Column="3"
                                          EditValue="{Binding Conditions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <dxg:GridControl AutoGenerateColumns="None"
                                             ItemsSource="{Binding ProcedureSteps}"
                                             SelectedItem="{Binding SelectedStep, Mode=TwoWay}">
                                <dxg:GridControl.Columns>
                                    <dxg:GridColumn FieldName="Number" Header="#" Width="30" FixedWidth="True" AllowEditing="False" AllowResizing="False" />
                                    <dxg:GridColumn FieldName="Action" Header="Action" Width="200">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:MemoEditSettings AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" ShowIcon="False" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="ExpectedResult" Header="Expected" Width="180">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:MemoEditSettings AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" ShowIcon="False" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="ActualResult" Header="Actual" Width="180">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:MemoEditSettings AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" ShowIcon="False" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                    <dxg:GridColumn FieldName="Result" Header="Result" Width="95" FixedWidth="True">
                                        <dxg:GridColumn.EditSettings>
                                            <dxe:ComboBoxEditSettings IsTextEditable="False" ItemsSource="{Binding DataContext.PossibleStepResults, RelativeSource={RelativeSource AncestorType=dxg:GridControl}}" />
                                        </dxg:GridColumn.EditSettings>
                                    </dxg:GridColumn>
                                </dxg:GridControl.Columns>
                                <dxg:GridControl.View>
                                    <dxg:TableView AutoWidth="True"
                                                   NavigationStyle="Cell"
                                                   RowMinHeight="24"
                                                   ShowGroupPanel="False"
                                                   ShowIndicator="False"
                                                   UseLightweightTemplates="None" />
                                </dxg:GridControl.View>
                            </dxg:GridControl>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <Button Margin="0,0,0,4" MinWidth="66" Padding="6,3" Command="{Binding AddStepCommand}" Content="Add" />
                                <Button Margin="0,0,0,4" MinWidth="66" Padding="6,3" Command="{Binding RemoveStepCommand}" Content="Remove" />
                                <Button Margin="0,0,0,4" MinWidth="66" Padding="6,3" Command="{Binding MoveStepUpCommand}" Content="Up" />
                                <Button MinWidth="66" Padding="6,3" Command="{Binding MoveStepDownCommand}" Content="Down" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </lc:LayoutGroup>

                <!--  EXECUTION  -->
                <lc:LayoutGroup Header="Execution" Orientation="Vertical" VerticalAlignment="Top">
                    <TextBlock Margin="4,2,4,8"
                               FontWeight="Bold"
                               Foreground="#FF9A6B00"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsPerformedByActivity, Converter={dx:BooleanToVisibilityConverter}}"
                               Text="A shared activity performs this item: its execution is recorded once, on the activity, and every field left empty here inherits from it. Fill these fields only to record something specific to this requirement." />
                    <lc:LayoutItem Label="Status: ">
                        <dxe:ComboBoxEdit IsTextEditable="False"
                                          ItemsSource="{Binding PossibleStatuses}"
                                          EditValue="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Actual Date: ">
                        <dxe:DateEdit EditValue="{Binding ActualDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Result: ">
                        <dxe:TextEdit Height="110"
                                      AcceptsReturn="True"
                                      TextWrapping="Wrap"
                                      VerticalContentAlignment="Top"
                                      EditValue="{Binding Result, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Evidence Ref.: " ToolTip="The report or record backing the result. References already used in the model, and the reports defined in it, are offered.">
                        <dxe:ComboBoxEdit AutoComplete="True"
                                          IsTextEditable="True"
                                          ItemsSource="{Binding SuggestedEvidenceReferences}"
                                          EditValue="{Binding EvidenceReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>

                    <TextBlock Margin="4,8,4,0"
                               FontStyle="Italic"
                               Foreground="#FF5A6B7D"
                               TextWrapping="Wrap"
                               Text="These fields may be left empty while the activity is only planned, and filled in later. An item performed by a shared activity inherits the activity's execution record for every field it leaves empty." />
                </lc:LayoutGroup>

                <!--  COMPLIANCE, the ECSS close-out record: does the design meet the requirement, and has that been accepted  -->
                <lc:LayoutGroup Header="Compliance" Orientation="Vertical" VerticalAlignment="Top">
                    <TextBlock Margin="4,2,4,8"
                               FontStyle="Italic"
                               Foreground="#FF5A6B7D"
                               TextWrapping="Wrap"
                               Text="Compliance answers whether the design meets the requirement, which is not the same as whether the activity ran. A test can pass while the requirement is only partly met, and that is the case a waiver or deviation covers. Close-out records the customer accepting this item. Requirement Closure is a separate question again: it says whether the requirement itself is finished, or whether more V&amp;V is owed at a later stage gate. Compliance and closure are recorded per item, so they can differ from one stage gate to the next." />
                    <lc:LayoutItem Label="Compliance: ">
                        <dxe:ComboBoxEdit IsTextEditable="False"
                                          ItemsSource="{Binding PossibleCompliances}"
                                          EditValue="{Binding Compliance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Analysis Check: " ToolTip="Evaluated from the model: the parameter named on the Coverage tab, checked against the requirement's parametric constraints. It informs your compliance judgement, it never makes it.">
                        <TextBlock VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="{Binding AnalysisCheck, Mode=OneWay}" />
                    </lc:LayoutItem>

                    <lc:LayoutItem Label="Requirement Closure: " ToolTip="Does finishing this item finish the requirement, or is further V&amp;V owed at a later stage gate? Leaving this at Not Assessed marks the requirement as undefined in the stage gate review, which is where planning gaps are meant to show up.">
                        <dxe:ComboBoxEdit IsTextEditable="False"
                                          ItemsSource="{Binding PossibleClosures}"
                                          EditValue="{Binding Closure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>

                    <lc:LayoutItem Label="Closed: ">
                        <dxe:CheckEdit Content="the customer has accepted this verification"
                                       IsChecked="{Binding IsClosed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Reason: ">
                        <dxe:TextEdit Height="50"
                                      AcceptsReturn="True"
                                      TextWrapping="Wrap"
                                      VerticalContentAlignment="Top"
                                      EditValue="{Binding CloseOutReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Closed By: ">
                        <dxe:TextEdit EditValue="{Binding ClosedBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Closed On: ">
                        <dxe:DateEdit EditValue="{Binding ClosedOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                </lc:LayoutGroup>

                <!--  COVERAGE - which slice of the requirement this activity actually covers  -->
                <lc:LayoutGroup Header="Coverage" Orientation="Vertical" VerticalAlignment="Top">
                    <TextBlock Margin="4,2,4,8"
                               FontStyle="Italic"
                               Foreground="#FF5A6B7D"
                               TextWrapping="Wrap"
                               Text="Optional. Narrow this activity to the parameter it measures and the article it is run on. Options and states appear only when the chosen parameter actually depends on them. You can also drag a parameter from the Element Definitions browser onto a V&amp;V item in the register." />
                    <lc:LayoutItem Label="Verified On: ">
                        <dxe:ComboBoxEdit DisplayMember="Name"
                                          IsTextEditable="False"
                                          NullValueButtonPlacement="EditBox"
                                          ItemsSource="{Binding PossibleElementDefinitions}"
                                          SelectedItem="{Binding SelectedElementDefinition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Covers Parameter: ">
                        <dxe:ComboBoxEdit DisplayMember="ParameterType.Name"
                                          IsTextEditable="False"
                                          NullValueButtonPlacement="EditBox"
                                          ItemsSource="{Binding PossibleParameters}"
                                          SelectedItem="{Binding SelectedParameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Covers Options: "
                                   Visibility="{Binding IsParameterOptionDependent, Converter={dx:BooleanToVisibilityConverter}}">
                        <ListBox Height="80"
                                 BorderThickness="1"
                                 ItemsSource="{Binding PossibleOptions}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Display}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </lc:LayoutItem>
                    <lc:LayoutItem Label="Covers States: "
                                   Visibility="{Binding IsParameterStateDependent, Converter={dx:BooleanToVisibilityConverter}}">
                        <ListBox Height="80"
                                 BorderThickness="1"
                                 ItemsSource="{Binding PossibleStates}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Display}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </lc:LayoutItem>
                </lc:LayoutGroup>

            </lc:LayoutGroup>
        </lc:LayoutControl>

        <StackPanel Grid.Row="1"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="90"
                    Height="26"
                    Margin="4,0"
                    Command="{Binding OkCommand}"
                    Content="{Binding OkButtonCaption}"
                    IsDefault="True" />
            <Button Width="90"
                    Height="26"
                    Margin="4,0"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</dx:DXWindow>
