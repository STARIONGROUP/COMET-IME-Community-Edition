<dx:DXWindow x:Class="CDP4Requirements.Views.VandVLinkItemsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:navigation="clr-namespace:CDP4Composition.Navigation;assembly=CDP4Composition"
             Width="880"
             Height="560"
             dx:ThemeManager.ThemeName="Seven"
             navigation:ExtendedDialogResultCloser.DialogResult="{Binding DialogResult}"
             mc:Ignorable="d"
             Title="{Binding Title}">

    <dx:DXWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CDP4Composition;component/CommonView/Resources/CDP4Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </dx:DXWindow.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap">
            <Run Text="Tick the existing V&amp;V items that are actually performed by " /><Run FontWeight="Bold" Text="{Binding ActivityCaption, Mode=OneWay}" /><Run Text=". They keep their acceptance criteria and coverage. " /><Run Text="{Binding PlanningCaption, Mode=OneWay}" />
        </TextBlock>

        <StackPanel Grid.Row="1" Margin="0,0,0,4" Orientation="Horizontal">
            <Button Margin="0,0,4,0" Padding="8,2" Command="{Binding SelectAllCommand}" Content="Select All" />
            <Button Margin="0,0,12,0" Padding="8,2" Command="{Binding ClearSelectionCommand}" Content="Clear" />
            <dxe:CheckEdit VerticalAlignment="Center"
                           Content="let the ticked items follow this activity's method and stage gate"
                           ToolTip="Clears the method and stage gate the ticked items state themselves, so they inherit the activity's. Leave this off to keep what each item says."
                           IsChecked="{Binding ClearOwnPlanning, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!--  a tick-box list, the same shape the other bulk dialogs use: a DevExpress grid with an in-place check
              editor both refused a single click and blew up during measure inside this window  -->
        <ListBox Grid.Row="2"
                 BorderThickness="1"
                 ItemsSource="{Binding Items}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Display}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2"
                   Margin="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontStyle="Italic"
                   Foreground="#FF5A6B7D"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasNothingToLink, Converter={dx:BooleanToVisibilityConverter}}"
                   Text="There is no other V&amp;V item to link: this activity already performs every V&amp;V item in the model. Create items for uncovered requirements with 'Create V&amp;V Items for new Requirements'." />

        <StackPanel Grid.Row="3"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="90"
                    Height="26"
                    Margin="4,0"
                    Command="{Binding OkCommand}"
                    Content="Link"
                    IsDefault="True" />
            <Button Width="90"
                    Height="26"
                    Margin="4,0"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</dx:DXWindow>
